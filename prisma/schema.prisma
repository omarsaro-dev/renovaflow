// RenovaFlow — Prisma schema
// SQLite for the demo/MVP. The model is intentionally portable to PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  WORKER
  CUSTOMER
}

enum OrgRole {
  ADMIN
  MANAGER
  WORKER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  READY_FOR_REVIEW
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BudgetCategoryType {
  MATERIALS
  LABOR
  PERMITS
  SUBCONTRACTORS
  OTHER
}

enum ChangeRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum FileVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
}

enum UpdateVisibility {
  CUSTOMER_VISIBLE
  INTERNAL
}

enum NotificationType {
    TASK_ASSIGNED
    TASK_STATUS_CHANGED
    TASK_DEADLINE_APPROACHING
    TASK_OVERDUE
    UPDATE_PUBLISHED
    MESSAGE
    CHANGE_REQUEST_CREATED
    DECISION_SUBMITTED
    DECISION_REJECTED
    PROJECT_CREATED
    PROJECT_STATUS_CHANGED
    EXPENSE_ADDED
    BUDGET_WARNING
    MEMBER_ADDED
    FILE_UPLOADED
  }

enum ActivityEventType {
    PROJECT_CREATED
    PROJECT_STATUS_CHANGED
    MEMBER_ADDED
    TASK_CREATED
    TASK_ASSIGNED
    TASK_STATUS_CHANGED
    TASK_COMPLETED
    EXPENSE_ADDED
    EXPENSE_UPDATED
    CHANGE_REQUEST_CREATED
    CHANGE_REQUEST_SUBMITTED
    DECISION_SUBMITTED
    DECISION_REJECTED
    BUDGET_CHANGED
    FILE_UPLOADED
    FILE_DELETED
    UPDATE_PUBLISHED
    CUSTOMER_COMMENTED
  }

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  phone        String?
  role         Role     @default(WORKER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerRecord      Customer?                @relation("CustomerLogin")
  organizationMembers OrganizationMember[]
  projectMembers      ProjectMember[]
  createdProjects     Project[]                @relation("ProjectCreator")
  managedProjects     Project[]                @relation("ProjectManager")
  createdTasks        Task[]                   @relation("TaskCreator")
  assignedTasks       Task[]                   @relation("TaskAssignee")
  taskNotes           TaskNote[]
  files               File[]
  comments            Comment[]
  notifications       Notification[]
  activityEvents      ActivityEvent[]
  updates             Update[]
  changeRequests      ChangeRequest[]
  expenses            Expense[]
  notificationPrefs   NotificationPreference[]
  resetTokens         PasswordResetToken[]
}

model Organization {
  id                     String   @id @default(cuid())
  name                   String
  logo                   String?
  email                  String?
  phone                  String?
  address                String?
  website                String?
  plan                   String   @default("Starter")
  budgetWarningThreshold Float    @default(85)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  members          OrganizationMember[]
  projects         Project[]
  customers        Customer[]
  projectMembers   ProjectMember[]
  teamTasks        Task[]
  budgetCategories BudgetCategory[]
  teamFiles        File[]
  teamExpenses     Expense[]
  changeRequests   ChangeRequest[]
  updates          Update[]
  comments         Comment[]
  notifications    Notification[]
  activityEvents   ActivityEvent[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(WORKER)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  @unique
  name           String
  email          String?
  phone          String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("CustomerLogin", fields: [userId], references: [id], onDelete: SetNull)
  projects     Project[]

  @@index([organizationId])
}

model ProjectMember {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  userId         String
  role           OrgRole  @default(WORKER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Project {
  id                     String        @id @default(cuid())
  organizationId         String
  customerId             String?
  managerId              String?
  createdById            String
  name                   String
  address                String?
  description            String?
  status                 ProjectStatus @default(PLANNING)
  startDate              DateTime?
  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?
  initialBudget          Float         @default(0)
  currentApprovedBudget  Float         @default(0)
  progress               Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  manager      User?        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)

  members          ProjectMember[]
  tasks            Task[]
  budgetCategories BudgetCategory[]
  expenses         Expense[]
  changeRequests   ChangeRequest[]
  files            File[]
  updates          Update[]
  activityEvents   ActivityEvent[]
  notifications    Notification[]

  @@index([organizationId])
  @@index([customerId])
  @@index([managerId])
  @@index([status])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  assigneeId     String?
  creatorId      String
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  files    File[]
  notes    TaskNote[]
  expenses Expense[]

  @@index([organizationId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([projectId, status])
}

model TaskNote {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model BudgetCategory {
  id              String             @id @default(cuid())
  organizationId  String
  projectId       String
  name            String
  type            BudgetCategoryType @default(OTHER)
  estimatedAmount Float              @default(0)
  approvedAmount  Float              @default(0)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  changeRequests ChangeRequest[]

  @@unique([projectId, type])
  @@index([organizationId])
  @@index([projectId])
}

model Expense {
  id              String   @id @default(cuid())
  organizationId  String
  projectId       String
  categoryId      String?
  taskId          String?
  createdById     String
  description     String
  estimatedAmount Float?
  actualAmount    Float    @default(0)
  vendor          String?
  date            DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category     BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  task         Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  files        File[]

  @@index([organizationId])
  @@index([projectId])
  @@index([categoryId])
}

model ChangeRequest {
  id                 String              @id @default(cuid())
  organizationId     String
  projectId          String
  budgetCategoryId   String?
  title              String
  reason             String
  costImpact         Float               @default(0)
  scheduleImpactDays Int                 @default(0)
  scheduleImpactNote String?
  status             ChangeRequestStatus @default(DRAFT)
  requesterId        String
  customerComment    String?
  decisionAt         DateTime?
  submittedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetCategory BudgetCategory? @relation(fields: [budgetCategoryId], references: [id], onDelete: SetNull)
  requester      User            @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  files          File[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
}

model File {
  id              String         @id @default(cuid())
  organizationId  String
  projectId       String?
  taskId          String?
  expenseId       String?
  changeRequestId String?
  updateId        String?
  uploaderId      String
  originalName    String
  storedName      String
  mimeType        String
  size            Int
  url             String
  thumbnailUrl    String?
  description     String?
  visibility      FileVisibility @default(INTERNAL)
  isImage         Boolean        @default(false)
  createdAt       DateTime       @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  expense       Expense?       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  update        Update?        @relation(fields: [updateId], references: [id], onDelete: Cascade)
  uploader      User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
  @@index([taskId])
  @@index([visibility])
}

model Update {
  id             String           @id @default(cuid())
  organizationId String
  projectId      String
  authorId       String
  title          String
  body           String
  visibility     UpdateVisibility @default(CUSTOMER_VISIBLE)
  isPublished    Boolean          @default(false)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments     Comment[]
  files        File[]

  @@index([organizationId])
  @@index([projectId])
  @@index([isPublished])
}

model Comment {
  id             String   @id @default(cuid())
  organizationId String
  updateId       String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  update       Update       @relation(fields: [updateId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([updateId])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  projectId      String?
  userId         String
  type           NotificationType
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId, readAt])
  @@index([userId])
}

model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityEvent {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String?
  actorId        String?
  type           ActivityEventType
  title          String
  metadata       Json?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorId])
}
