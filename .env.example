# RenovaFlow environment variables
# Copy this file to `.env` and fill in real values.

# PostgreSQL connection string (Neon / Supabase / Vercel Postgres / local)
# For your local database:
#   postgresql://postgres:postgres@localhost:5432/renovaflow
DATABASE_URL="postgresql://user:password@host:5432/renovaflow"

# NextAuth secret — generate with: npx auth secret  (or any long random string)
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Public base URL (http://localhost:3000 in dev, your Vercel URL in production)
NEXTAUTH_URL="http://localhost:3000"

# Local file storage for uploads
UPLOAD_DIR="./data/uploads"
THUMB_DIR="./data/thumbnails"
MAX_FILE_SIZE_MB="25"